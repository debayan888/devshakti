{"fps": 60, "total": 3444, "lines": [{"id": "d1", "text": "Show me the arm first.", "speaker": "dev", "t0": 36, "n": 98, "words": [{"w": "Show", "a": 36, "b": 56}, {"w": "me", "a": 56, "b": 68}, {"w": "the", "a": 68, "b": 89}, {"w": "arm", "a": 89, "b": 106}, {"w": "first.", "a": 106, "b": 134}]}, {"id": "q1", "text": "That's a straight cut. Teeth don't cut straight.", "speaker": "ray", "t0": 324, "n": 181, "words": [{"w": "That's", "a": 324, "b": 346}, {"w": "a", "a": 346, "b": 364}, {"w": "straight", "a": 364, "b": 382}, {"w": "cut.", "a": 382, "b": 410}, {"w": "Teeth", "a": 410, "b": 435}, {"w": "don't", "a": 435, "b": 447}, {"w": "cut", "a": 447, "b": 473}, {"w": "straight.", "a": 473, "b": 505}]}, {"id": "d2", "text": "Mira. Open it.", "speaker": "dev", "t0": 540, "n": 80, "words": [{"w": "Mira.", "a": 540, "b": 571}, {"w": "Open", "a": 571, "b": 601}, {"w": "it.", "a": 601, "b": 620}]}, {"id": "m1", "text": "Sit down. Keep pressure on that.", "speaker": "mira", "t0": 756, "n": 119, "words": [{"w": "Sit", "a": 756, "b": 771}, {"w": "down.", "a": 771, "b": 799}, {"w": "Keep", "a": 799, "b": 810}, {"w": "pressure", "a": 810, "b": 835}, {"w": "on", "a": 835, "b": 853}, {"w": "that.", "a": 853, "b": 875}]}, {"id": "d3", "text": "Who are you? Why were you playing dead?", "speaker": "dev", "t0": 900, "n": 128, "words": [{"w": "Who", "a": 900, "b": 909}, {"w": "are", "a": 909, "b": 928}, {"w": "you?", "a": 928, "b": 947}, {"w": "Why", "a": 947, "b": 966}, {"w": "were", "a": 966, "b": 973}, {"w": "you", "a": 973, "b": 994}, {"w": "playing", "a": 994, "b": 1007}, {"w": "dead?", "a": 1007, "b": 1028}]}, {"id": "v1", "text": "Name's Cole. I drive for Saint Anne's.", "speaker": "drv", "t0": 1056, "n": 133, "words": [{"w": "Name's", "a": 1056, "b": 1078}, {"w": "Cole.", "a": 1078, "b": 1111}, {"w": "I", "a": 1111, "b": 1126}, {"w": "drive", "a": 1126, "b": 1129}, {"w": "for", "a": 1129, "b": 1147}, {"w": "Saint", "a": 1147, "b": 1160}, {"w": "Anne's.", "a": 1160, "b": 1189}]}, {"id": "v2", "text": "Tonight we moved six patients. Bitten... but not turned.", "speaker": "drv", "t0": 1212, "n": 172, "words": [{"w": "Tonight", "a": 1212, "b": 1228}, {"w": "we", "a": 1228, "b": 1246}, {"w": "moved", "a": 1246, "b": 1264}, {"w": "six", "a": 1264, "b": 1277}, {"w": "patients.", "a": 1277, "b": 1302}, {"w": "Bitten...", "a": 1302, "b": 1331}, {"w": "but", "a": 1331, "b": 1344}, {"w": "not", "a": 1344, "b": 1358}, {"w": "turned.", "a": 1358, "b": 1384}]}, {"id": "q2", "text": "Six? Where are they now?", "speaker": "ray", "t0": 1428, "n": 117, "words": [{"w": "Six?", "a": 1428, "b": 1456}, {"w": "Where", "a": 1456, "b": 1476}, {"w": "are", "a": 1476, "b": 1492}, {"w": "they", "a": 1492, "b": 1516}, {"w": "now?", "a": 1516, "b": 1545}]}, {"id": "v3", "text": "The back doors were locked when I froze. They're open now.", "speaker": "drv", "t0": 1584, "n": 170, "words": [{"w": "The", "a": 1584, "b": 1599}, {"w": "back", "a": 1599, "b": 1606}, {"w": "doors", "a": 1606, "b": 1622}, {"w": "were", "a": 1622, "b": 1625}, {"w": "locked", "a": 1625, "b": 1648}, {"w": "when", "a": 1648, "b": 1668}, {"w": "I", "a": 1668, "b": 1671}, {"w": "froze.", "a": 1671, "b": 1696}, {"w": "They're", "a": 1696, "b": 1712}, {"w": "open", "a": 1712, "b": 1736}, {"w": "now.", "a": 1736, "b": 1754}]}, {"id": "m2", "text": "Those straps weren't torn. They were cut.", "speaker": "mira", "t0": 1896, "n": 130, "words": [{"w": "Those", "a": 1896, "b": 1913}, {"w": "straps", "a": 1913, "b": 1918}, {"w": "weren't", "a": 1918, "b": 1950}, {"w": "torn.", "a": 1950, "b": 1976}, {"w": "They", "a": 1976, "b": 1987}, {"w": "were", "a": 1987, "b": 2000}, {"w": "cut.", "a": 2000, "b": 2026}]}, {"id": "q3", "text": "And the rear window's smashed.", "speaker": "ray", "t0": 2076, "n": 128, "words": [{"w": "And", "a": 2076, "b": 2094}, {"w": "the", "a": 2094, "b": 2108}, {"w": "rear", "a": 2108, "b": 2121}, {"w": "window's", "a": 2121, "b": 2161}, {"w": "smashed.", "a": 2161, "b": 2204}]}, {"i