{"fps": 60, "total": 2760, "lines": [{"id": "m1", "text": "Dev? Is that you?", "speaker": "radio", "t0": 15, "n": 76, "words": [{"w": "Dev?", "a": 15, "b": 43}, {"w": "Is", "a": 43, "b": 49}, {"w": "that", "a": 49, "b": 69}, {"w": "you?", "a": 69, "b": 91}]}, {"id": "d1", "text": "Wait. I never told her my name.", "speaker": "dev", "t0": 105, "n": 108, "words": [{"w": "Wait.", "a": 105, "b": 124}, {"w": "I", "a": 124, "b": 132}, {"w": "never", "a": 132, "b": 156}, {"w": "told", "a": 156, "b": 173}, {"w": "her", "a": 173, "b": 180}, {"w": "my", "a": 180, "b": 188}, {"w": "name.", "a": 188, "b": 213}]}, {"id": "d2", "text": "How do you know my name?", "speaker": "dev", "t0": 246, "n": 68, "words": [{"w": "How", "a": 246, "b": 259}, {"w": "do", "a": 259, "b": 261}, {"w": "you", "a": 261, "b": 279}, {"w": "know", "a": 279, "b": 281}, {"w": "my", "a": 281, "b": 295}, {"w": "name?", "a": 295, "b": 314}]}, {"id": "m2", "text": "Everyone here knows you. Apartment thirteen-oh-four. The guy who never pays rent.", "speaker": "radio", "t0": 330, "n": 293, "words": [{"w": "Everyone", "a": 330, "b": 372}, {"w": "here", "a": 372, "b": 385}, {"w": "knows", "a": 385, "b": 398}, {"w": "you.", "a": 398, "b": 417}, {"w": "Apartment", "a": 417, "b": 457}, {"w": "thirteen-oh-four.", "a": 457, "b": 525}, {"w": "The", "a": 525, "b": 530}, {"w": "guy", "a": 530, "b": 545}, {"w": "who", "a": 545, "b": 557}, {"w": "never", "a": 557, "b": 581}, {"w": "pays", "a": 581, "b": 602}, {"w": "rent.", "a": 602, "b": 623}]}, {"id": "m3", "text": "The main stairs are blocked. Take the service stairs. You'll need a maintenance keycard.", "speaker": "radio", "t0": 642, "n": 268, "words": [{"w": "The", "a": 642, "b": 653}, {"w": "main", "a": 653, "b": 667}, {"w": "stairs", "a": 667, "b": 679}, {"w": "are", "a": 679, "b": 688}, {"w": "blocked.", "a": 688, "b": 731}, {"w": "Take", "a": 731, "b": 738}, {"w": "the", "a": 738, "b": 750}, {"w": "service", "a": 750, "b": 780}, {"w": "stairs.", "a": 780, "b": 796}