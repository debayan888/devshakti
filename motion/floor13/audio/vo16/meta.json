{
 "m1": {
  "text": "Scratches. Not teeth.",
  "dur": 1.4933333333333334,
  "sr": 24000
 },
 "v1": {
  "text": "Doesn't matter. His nails were full of his own blood.",
  "dur": 2.7733333333333334,
  "sr": 24000
 },
 "m2": {
  "text": "This is going to sting.",
  "dur": 1.1946666666666668,
  "sr": 24000
 },
 "q1": {
  "text": "I worked here twenty years. I've had worse.",
  "dur": 3.029333333333333,
  "sr": 24000
 },
 "d1": {
  "text": "Look at the floor. Six patients...",
  "dur": 2.2826666666666666,
  "sr": 24000
 },
 "d2": {
  "text": "...seven sets of footprints.",
  "dur": 1.792,
  "sr": 24000
 },
 "q2": {
  "text": "My truck. Full tank. But that gate is loud.",
  "dur": 3.2213333333333334,
  "sr": 24000
 },
 "v2": {
  "text": "Loud brings the groaners. Light brings the quiet ones.",
  "dur": 3.029333333333333,
  "sr": 24000
 },
 "m3": {
  "text": "Then we wait for sunrise.",
  "dur": 1.3866666666666667,
  "sr": 24000
 },
 "d3": {
  "text": "Ray? ...Ray?",
  "dur": 1.3653333333333333,
  "sr": 24000
 },
 "q3": {
  "text": "Sorry. I'm here.",
  "dur": 1.8133333333333332,
  "sr": 24000
 },
 "s1": {
  "text": "Please... I'm patient seven. I'm not one of them. Not yet.",
  "dur": 3.541333333333333,
  "sr": 24000
 },
 "end": {
  "text": "Part fifteen. Patient seven.",
  "dur": 1.9413333333333334,
  "sr": 24000
 }
