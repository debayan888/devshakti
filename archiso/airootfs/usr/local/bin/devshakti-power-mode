#!/bin/bash
# ============================================================================
#  DevShakti OS — Power Mode Manager
#  /usr/local/bin/devshakti-power-mode
# ============================================================================
#
#  A unified power profile manager for HP Victus 15 laptops running
#  DevShakti OS.  Switches between Performance, Balanced, and Battery
#  Saver modes by adjusting CPU governor, GPU power profiles, display
#  brightness, and TLP runtime configuration.
#
#  Hardware Target:
#    CPU  : AMD Ryzen 7 7445HS (8C/16T, Zen 4)
#    iGPU : AMD Radeon 760M (RDNA 3)
#    dGPU : NVIDIA GeForce RTX 4050 Laptop (Ada Lovelace)
#    RAM  : 16 GB DDR5-4800
#    Bat  : 75 Wh
#
#  Usage:
#    devshakti-power-mode <performance|balanced|battery> [--quiet]
#    devshakti-power-mode --status
#    devshakti-power-mode --help
#
#  Dependencies:
#    - tlp (>= 1.6)
#    - cpupower
#    - brightnessctl
#    - notify-send (libnotify)
#    - logger (util-linux)
#    - AMD GPU sysfs interface
#    - NVIDIA smi (optional, for dGPU)
#
#  Exit Codes:
#    0 — Success
#    1 — Invalid arguments / usage error
#    2 — Missing dependency
#    3 — Insufficient permissions
#    4 — Hardware control failure
#
# ============================================================================

set -euo pipefail

# ============================================================================
#  Constants & Branding
# ============================================================================

readonly SCRIPT_NAME="devshakti-power-mode"
readonly SCRIPT_VERSION="1.0.0"
readonly STATE_FILE="/tmp/devshakti-power-mode.state"
readonly LOG_TAG="devshakti-power"
readonly ICON_PERFORMANCE="⚡"
readonly ICON_BALANCED="⚖️"
readonly ICON_BATTERY="🔋"

# Backlight device — AMD GPU backlight (typical for HP Victus 15)
readonly BACKLIGHT_DEVICE="amdgpu_bl1"

# AMD iGPU sysfs paths
readonly AMD_GPU_SYSFS="/sys/class/drm/card1/device"
readonly AMD_GPU_POWER_PROFILE="${AMD_GPU_SYSFS}/power_dpm_force_performance_level"
readonly AMD_GPU_DPM_STATE="${AMD_GPU_SYSFS}/power_dpm_state"

# Fallback AMD iGPU path (card0 on some configurations)
readonly AMD_GPU_SYSFS_ALT="/sys/class/drm/card0/device"
readonly AMD_GPU_POWER_PROFILE_ALT="${AMD_GPU_SYSFS_ALT}/power_dpm_force_performance_level"

# Color codes for terminal output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly MAGENTA='\033[0;35m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly NC='\033[0m' # No Color

# Quiet mode flag (suppress notifications, used by udev)
QUIET_MODE=0

# ============================================================================
#  Logging & Output
# ============================================================================

log_info() {
    logger -t "${LOG_TAG}" "INFO: $*"
    [[ "${QUIET_MODE}" -eq 0 ]] && echo -e "${GREEN}[DevShakti]${NC} $*"
}

log_warn() {
    logger -t "${LOG_TAG}" "WARN: $*"
    [[ "${QUIET_MODE}" -eq 0 ]] && echo -e "${YELLOW}[DevShakti]${NC} WARNING: $*" >&2
}

log_error() {
    logger -t "${LOG_TAG}" "ERROR: $*"
    echo -e "${RED}[DevShakti]${NC} ERROR: $*" >&2
}

log_debug() {
    logger -t "${LOG_TAG}" "DEBUG: $*"
}

# ============================================================================
#  Dependency Checks
# ============================================================================

check_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        log_error "This script must be run as root (or via sudo)."
        log_error "Usage: sudo ${SCRIPT_NAME} <mode>"
        exit 3
    fi
}

check_dependency() {
    local cmd="$1"
    local package="${2:-$1}"
    if ! command -v "${cmd}" &>/dev/null; then
        log_error "Missing dependency: '${cmd}' (install package: ${package})"
        return 1
    fi
    return 0
}

check_all_dependencies() {
    local missing=0

    check_dependency "tlp" "tlp" || missing=1
    check_dependency "cpupower" "cpupower" || missing=1
    check_dependency "brightnessctl" "brightnessctl" || missing=1
    check_dependency "logger" "util-linux" || missing=1

    # notify-send is optional (may not exist in tty / udev context)
    if ! command -v notify-send &>/dev/null; then
        log_debug "notify-send not found — desktop notifications will be skipped"
    fi

    if [[ "${missing}" -eq 1 ]]; then
        log_error "One or more required dependencies are missing. Aborting."
        exit 2
    fi
}

# ============================================================================
#  Hardware Detection
# ============================================================================

# Find the correct AMD GPU sysfs path
find_amd_gpu_sysfs() {
    if [[ -f "${AMD_GPU_POWER_PROFILE}" ]]; then
        echo "${AMD_GPU_POWER_PROFILE}"
    elif [[ -f "${AMD_GPU_POWER_PROFILE_ALT}" ]]; then
        echo "${AMD_GPU_POWER_PROFILE_ALT}"
    else
        # Search all DRM cards for an AMD device
        for card_dir in /sys/class/drm/card*/device; do
            if [[ -f "${card_dir}/vendor" ]]; then
                local vendor
                vendor=$(cat "${card_dir}/vendor" 2>/dev/null)
                if [[ "${vendor}" == "0x1002" ]] && [[ -f "${card_dir}/power_dpm_force_performance_level" ]]; then
                    echo "${card_dir}/power_dpm_force_performance_level"
                    return 0
                fi
            fi
        done
        echo ""
    fi
}

# Check if NVIDIA dGPU is present and accessible
nvidia_available() {
    command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null
}

# Get current power source
get_power_source() {
    local ac_online
    for supply in /sys/class/power_supply/A*/online /sys/class/power_supply/AC*/online; do
        if [[ -f "${supply}" ]]; then
            ac_online=$(cat "${supply}" 2>/dev/null)
            if [[ "${ac_online}" == "1" ]]; then
                echo "AC"
                return
            fi
        fi
    done
    echo "Battery"
}

# Get battery percentage
get_battery_percentage() {
    local bat_path
    for bat_path in /sys/class/power_supply/BAT*/capacity; do
        if [[ -f "${bat_path}" ]]; then
            cat "${bat_path}" 2>/dev/null
            return
        fi
    done
    echo "N/A"
}

# Get current CPU governor
get_current_governor() {
    cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown"
}

# Get current CPU boost state
get_cpu_boost() {
    if [[ -f /sys/devices/system/cpu/cpufreq/boost ]]; then
        local val
        val=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null)
        [[ "${val}" == "1" ]] && echo "enabled" || echo "disabled"
    else
        echo "N/A"
    fi
}

# ============================================================================
#  Power Mode Implementation
# ============================================================================

# --- Set CPU Governor ---
set_cpu_governor() {
    local governor="$1"
    log_info "Setting CPU governor to '${governor}'..."

    if cpupower frequency-set -g "${governor}" &>/dev/null; then
        log_info "CPU governor set to '${governor}' successfully."
    else
        log_warn "cpupower failed — attempting sysfs fallback..."
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo "${governor}" > "${cpu}" 2>/dev/null || true
        done
        log_info "CPU governor set via sysfs fallback."
    fi
}

# --- Set CPU Boost ---
set_cpu_boost() {
    local state="$1"  # 1 = enabled, 0 = disabled
    local label
    [[ "${state}" == "1" ]] && label="enabled" || label="disabled"

    log_info "Setting CPU boost to '${label}'..."

    if [[ -f /sys/devices/system/cpu/cpufreq/boost ]]; then
        echo "${state}" > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || \
            log_warn "Could not set CPU boost via sysfs."
    fi

    # AMD-specific: amd_pstate boost control
    if [[ -f /sys/devices/system/cpu/amd_pstate/cpb_boost ]]; then
        echo "${state}" > /sys/devices/system/cpu/amd_pstate/cpb_boost 2>/dev/null || true
    fi

    log_info "CPU boost ${label}."
}

# --- Set AMD iGPU Power Profile ---
set_amd_gpu_profile() {
    local level="$1"  # auto, low, high, manual, profile_standard, etc.
    local gpu_path
    gpu_path=$(find_amd_gpu_sysfs)

    if [[ -z "${gpu_path}" ]]; then
        log_warn "AMD iGPU sysfs path not found — skipping GPU profile."
        return
    fi

    log_info "Setting AMD iGPU DPM performance level to '${level}'..."

    if echo "${level}" > "${gpu_path}" 2>/dev/null; then
        log_info "AMD iGPU set to '${level}'."
    else
        log_warn "Could not set AMD iGPU performance level (may require amdgpu driver)."
    fi
}

# --- Set NVIDIA dGPU Power Mode ---
set_nvidia_power() {
    local mode="$1"  # "performance" or "powersave"

    if ! nvidia_available; then
        log_debug "NVIDIA GPU not available or driver not loaded — skipping."
        return
    fi

    log_info "Configuring NVIDIA RTX 4050 for '${mode}' mode..."

    case "${mode}" in
        performance)
            # Set persistence mode for faster GPU wake-up
            nvidia-smi -pm 1 &>/dev/null || true
            # Remove power limit cap (let GPU use full TGP)
            nvidia-smi -pl 115 &>/dev/null || true
            log_info "NVIDIA GPU: persistence mode ON, power limit set to max."
            ;;
        balanced)
            nvidia-smi -pm 1 &>/dev/null || true
            # Moderate power limit
            nvidia-smi -pl 80 &>/dev/null || true
            log_info "NVIDIA GPU: persistence mode ON, power limit set to 80W."
            ;;
        powersave)
            # Enable runtime PM so GPU can enter D3cold
            for dev in /sys/bus/pci/devices/*/vendor; do
                local dir
                dir=$(dirname "${dev}")
                if [[ "$(cat "${dev}" 2>/dev/null)" == "0x10de" ]]; then
                    if [[ -f "${dir}/power/control" ]]; then
                        echo "auto" > "${dir}/power/control" 2>/dev/null || true
                    fi
                fi
            done
            # Disable persistence mode to allow GPU to fully power off
            nvidia-smi -pm 0 &>/dev/null || true
            log_info "NVIDIA GPU: runtime PM enabled, persistence mode OFF."
            ;;
    esac
}

# --- Set Display Brightness ---
set_brightness() {
    local percent="$1"

    log_info "Setting display brightness to ${percent}%..."

    if command -v brightnessctl &>/dev/null; then
        brightnessctl --device="${BACKLIGHT_DEVICE}" set "${percent}%" &>/dev/null 2>&1 || \
        brightnessctl set "${percent}%" &>/dev/null 2>&1 || \
            log_warn "Could not set brightness via brightnessctl."
    else
        # Fallback to raw sysfs
        local bl_path="/sys/class/backlight/${BACKLIGHT_DEVICE}"
        if [[ -f "${bl_path}/max_brightness" ]] && [[ -f "${bl_path}/brightness" ]]; then
            local max_br
            max_br=$(cat "${bl_path}/max_brightness")
            local target_br=$(( max_br * percent / 100 ))
            echo "${target_br}" > "${bl_path}/brightness" 2>/dev/null || \
                log_warn "Could not set brightness via sysfs."
        fi
    fi

    log_info "Brightness set to ${percent}%."
}

# --- Set ACPI Platform Profile ---
set_platform_profile() {
    local profile="$1"  # performance, balanced, low-power
    local profile_path="/sys/firmware/acpi/platform_profile"

    if [[ -f "${profile_path}" ]]; then
        log_info "Setting ACPI platform profile to '${profile}'..."
        echo "${profile}" > "${profile_path}" 2>/dev/null || \
            log_warn "Could not set platform profile (check firmware support)."
    else
        log_debug "ACPI platform_profile not available on this system."
    fi
}

# --- Set PCIe ASPM Policy ---
set_pcie_aspm() {
    local policy="$1"  # default, performance, powersave, powersupersave
    local aspm_path="/sys/module/pcie_aspm/parameters/policy"

    if [[ -f "${aspm_path}" ]]; then
        log_info "Setting PCIe ASPM policy to '${policy}'..."
        echo "${policy}" > "${aspm_path}" 2>/dev/null || \
            log_warn "Could not set PCIe ASPM policy."
    else
        log_debug "PCIe ASPM sysfs interface not available."
    fi
}

# --- Send Desktop Notification ---
send_notification() {
    local title="$1"
    local body="$2"
    local icon="${3:-dialog-information}"
    local urgency="${4:-normal}"

    if [[ "${QUIET_MODE}" -eq 1 ]]; then
        return
    fi

    if ! command -v notify-send &>/dev/null; then
        log_debug "notify-send not available — skipping desktop notification."
        return
    fi

    # notify-send must run as the desktop user, not root.
    # Find the active graphical session user.
    local display_user=""
    local display_env=""
    local dbus_addr=""

    # Try to find active graphical session
    if command -v loginctl &>/dev/null; then
        local sessions
        sessions=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')
        for session in ${sessions}; do
            local stype
            stype=$(loginctl show-session "${session}" -p Type --value 2>/dev/null)
            if [[ "${stype}" == "x11" ]] || [[ "${stype}" == "wayland" ]]; then
                display_user=$(loginctl show-session "${session}" -p Name --value 2>/dev/null)
                break
            fi
        done
    fi

    if [[ -z "${display_user}" ]]; then
        # Fallback: try the SUDO_USER or first user with UID >= 1000
        display_user="${SUDO_USER:-}"
        if [[ -z "${display_user}" ]]; then
            display_user=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}' /etc/passwd 2>/dev/null)
        fi
    fi

    if [[ -n "${display_user}" ]]; then
        local uid
        uid=$(id -u "${display_user}" 2>/dev/null)
        if [[ -n "${uid}" ]]; then
            dbus_addr="unix:path=/run/user/${uid}/bus"
            # Send notification as the desktop user
            su - "${display_user}" -c \
                "DBUS_SESSION_BUS_ADDRESS='${dbus_addr}' notify-send \
                --urgency='${urgency}' \
                --app-name='DevShakti Power' \
                --icon='${icon}' \
                '${title}' '${body}'" &>/dev/null || \
                log_debug "Could not send notification to user '${display_user}'."
        fi
    else
        log_debug "No graphical session user found — notification skipped."
    fi
}

# --- Save Current Mode State ---
save_state() {
    local mode="$1"
    echo "${mode}" > "${STATE_FILE}" 2>/dev/null || true
    log_debug "Power mode state saved: ${mode}"
}

# --- Read Current Mode State ---
read_state() {
    if [[ -f "${STATE_FILE}" ]]; then
        cat "${STATE_FILE}" 2>/dev/null
    else
        echo "unknown"
    fi
}

# ============================================================================
#  Power Mode Profiles
# ============================================================================

apply_performance_mode() {
    log_info ""
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info "  ${ICON_PERFORMANCE}  DevShakti Power Mode: PERFORMANCE"
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info ""

    # CPU: Max performance
    set_cpu_governor "performance"
    set_cpu_boost 1

    # Platform: Full TDP
    set_platform_profile "performance"

    # iGPU: High performance
    set_amd_gpu_profile "high"

    # dGPU: Full power
    set_nvidia_power "performance"

    # PCIe: No power saving
    set_pcie_aspm "performance"

    # Brightness: Maximum comfortable
    set_brightness 100

    # TLP: Force AC profile
    tlp ac &>/dev/null || log_warn "TLP ac mode switch failed."

    # Save state
    save_state "performance"

    # Notification
    send_notification \
        "${ICON_PERFORMANCE} Performance Mode" \
        "Maximum performance enabled.\nCPU boost ON • GPU high • Full brightness" \
        "battery-full-charged" \
        "normal"

    log_info ""
    log_info "Performance mode applied successfully."
    log_info ""
}

apply_balanced_mode() {
    log_info ""
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info "  ${ICON_BALANCED}  DevShakti Power Mode: BALANCED"
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info ""

    # CPU: On-demand scaling
    set_cpu_governor "schedutil"
    set_cpu_boost 1

    # Platform: Balanced TDP
    set_platform_profile "balanced"

    # iGPU: Automatic
    set_amd_gpu_profile "auto"

    # dGPU: Moderate power
    set_nvidia_power "balanced"

    # PCIe: Default ASPM
    set_pcie_aspm "default"

    # Brightness: Moderate
    set_brightness 65

    # TLP: Re-apply current power source profile
    tlp start &>/dev/null || log_warn "TLP restart failed."

    # Save state
    save_state "balanced"

    # Notification
    send_notification \
        "${ICON_BALANCED} Balanced Mode" \
        "Balanced performance & efficiency.\nCPU boost ON • GPU auto • 65% brightness" \
        "battery-good" \
        "normal"

    log_info ""
    log_info "Balanced mode applied successfully."
    log_info ""
}

apply_battery_mode() {
    log_info ""
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info "  ${ICON_BATTERY}  DevShakti Power Mode: BATTERY SAVER"
    log_info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info ""

    # CPU: Maximum power savings
    set_cpu_governor "powersave"
    set_cpu_boost 0

    # Platform: Low power TDP
    set_platform_profile "low-power"

    # iGPU: Force low
    set_amd_gpu_profile "low"

    # dGPU: Allow full suspend
    set_nvidia_power "powersave"

    # PCIe: Deep power saving
    set_pcie_aspm "powersupersave"

    # Brightness: Conservative
    set_brightness 35

    # TLP: Force battery profile
    tlp bat &>/dev/null || log_warn "TLP bat mode switch failed."

    # Save state
    save_state "battery"

    # Notification
    send_notification \
        "${ICON_BATTERY} Battery Saver Mode" \
        "Maximum battery life enabled.\nCPU boost OFF • GPU low • 35% brightness" \
        "battery-low" \
        "normal"

    log_info ""
    log_info "Battery saver mode applied successfully."
    log_info ""
}

# ============================================================================
#  Status Display
# ============================================================================

show_status() {
    local current_mode
    current_mode=$(read_state)
    local power_source
    power_source=$(get_power_source)
    local battery_pct
    battery_pct=$(get_battery_percentage)
    local governor
    governor=$(get_current_governor)
    local boost
    boost=$(get_cpu_boost)

    local gpu_level="N/A"
    local gpu_path
    gpu_path=$(find_amd_gpu_sysfs)
    if [[ -n "${gpu_path}" ]] && [[ -f "${gpu_path}" ]]; then
        gpu_level=$(cat "${gpu_path}" 2>/dev/null || echo "N/A")
    fi

    local nvidia_status="N/A"
    if nvidia_available; then
        nvidia_status=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null || echo "N/A")
        [[ -n "${nvidia_status}" ]] && nvidia_status="${nvidia_status}W"
    fi

    local platform_profile="N/A"
    if [[ -f /sys/firmware/acpi/platform_profile ]]; then
        platform_profile=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || echo "N/A")
    fi

    local brightness="N/A"
    if command -v brightnessctl &>/dev/null; then
        brightness=$(brightnessctl --device="${BACKLIGHT_DEVICE}" get --percentage 2>/dev/null || \
                     brightnessctl get --percentage 2>/dev/null || echo "N/A")
        [[ "${brightness}" != "N/A" ]] && brightness="${brightness}%"
    fi

    local mode_icon
    case "${current_mode}" in
        performance) mode_icon="${ICON_PERFORMANCE}" ;;
        balanced)    mode_icon="${ICON_BALANCED}" ;;
        battery)     mode_icon="${ICON_BATTERY}" ;;
        *)           mode_icon="❓" ;;
    esac

    echo ""
    echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${CYAN}  DevShakti OS — Power Status${NC}"
    echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  ${BOLD}Current Mode${NC}     : ${mode_icon}  ${BOLD}${current_mode^^}${NC}"
    echo -e "  ${BOLD}Power Source${NC}     : ${power_source}"
    echo -e "  ${BOLD}Battery Level${NC}    : ${battery_pct}%"
    echo ""
    echo -e "  ${BOLD}${MAGENTA}── CPU ──${NC}"
    echo -e "  Governor          : ${governor}"
    echo -e "  Turbo Boost       : ${boost}"
    echo ""
    echo -e "  ${BOLD}${MAGENTA}── GPU ──${NC}"
    echo -e "  AMD iGPU Level    : ${gpu_level}"
    echo -e "  NVIDIA dGPU Power : ${nvidia_status}"
    echo ""
    echo -e "  ${BOLD}${MAGENTA}── System ──${NC}"
    echo -e "  Platform Profile  : ${platform_profile}"
    echo -e "  Display Brightness: ${brightness}"
    echo ""
    echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

# ============================================================================
#  Help / Usage
# ============================================================================

show_help() {
    cat <<EOF

${BOLD}DevShakti OS — Power Mode Manager v${SCRIPT_VERSION}${NC}

${BOLD}USAGE:${NC}
    sudo ${SCRIPT_NAME} <MODE> [OPTIONS]
    sudo ${SCRIPT_NAME} --status
    sudo ${SCRIPT_NAME} --help

${BOLD}MODES:${NC}
    ${GREEN}performance${NC}   Maximum performance. CPU boost ON, GPU high, full brightness.
                  Best for gaming, compiling, video editing.

    ${YELLOW}balanced${NC}      Balanced performance & efficiency. CPU boost ON with
                  dynamic scaling, GPU auto, moderate brightness.
                  Best for everyday use.

    ${BLUE}battery${NC}       Maximum battery life. CPU boost OFF, GPU low, reduced
                  brightness. Best for extended unplugged use.

${BOLD}OPTIONS:${NC}
    --quiet       Suppress terminal output and desktop notifications.
                  Used internally by udev rules.
    --status      Display current power mode and hardware status.
    --help        Show this help message.

${BOLD}EXAMPLES:${NC}
    sudo ${SCRIPT_NAME} performance        # Switch to performance mode
    sudo ${SCRIPT_NAME} battery --quiet    # Silent battery mode (for udev)
    sudo ${SCRIPT_NAME} --status           # Show current status

${BOLD}HARDWARE:${NC}
    HP Victus 15 • AMD Ryzen 7 7445HS • Radeon 760M + RTX 4050

EOF
}

# ============================================================================
#  Argument Parsing & Main
# ============================================================================

main() {
    local mode=""
    local show_status_flag=0
    local show_help_flag=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            performance|balanced|battery)
                mode="$1"
                ;;
            --quiet|-q)
                QUIET_MODE=1
                ;;
            --status|-s)
                show_status_flag=1
                ;;
            --help|-h)
                show_help_flag=1
                ;;
            --version|-v)
                echo "${SCRIPT_NAME} v${SCRIPT_VERSION}"
                exit 0
                ;;
            *)
                log_error "Unknown argument: '$1'"
                echo ""
                echo "Run '${SCRIPT_NAME} --help' for usage information."
                exit 1
                ;;
        esac
        shift
    done

    # Handle --help (no root needed)
    if [[ "${show_help_flag}" -eq 1 ]]; then
        show_help
        exit 0
    fi

    # Handle --status (no root needed for reading)
    if [[ "${show_status_flag}" -eq 1 ]]; then
        show_status
        exit 0
    fi

    # Validate mode was provided
    if [[ -z "${mode}" ]]; then
        log_error "No power mode specified."
        echo ""
        echo "Usage: sudo ${SCRIPT_NAME} <performance|balanced|battery>"
        echo "       ${SCRIPT_NAME} --status"
        echo "       ${SCRIPT_NAME} --help"
        exit 1
    fi

    # Root check for mode switching
    check_root

    # Dependency check
    check_all_dependencies

    # Apply the requested mode
    case "${mode}" in
        performance)
            apply_performance_mode
            ;;
        balanced)
            apply_balanced_mode
            ;;
        battery)
            apply_battery_mode
            ;;
    esac

    exit 0
}

# Run main
main "$@"
