#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                        DevShakti OS — GPU Select                           ║
# ║                                                                            ║
# ║  Switch between AMD / NVIDIA / Hybrid GPU rendering modes on dual-GPU      ║
# ║  laptops (AMD Radeon 680M iGPU + NVIDIA RTX 4050 dGPU).                    ║
# ║                                                                            ║
# ║  Usage:                                                                    ║
# ║    devshakti-gpu-select <amd|nvidia|hybrid>                                ║
# ║    devshakti-gpu-select --status                                           ║
# ║    devshakti-gpu-select --help                                             ║
# ║                                                                            ║
# ║  Copyright © 2026 DevShakti Project — MIT License                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Constants & Paths
# ─────────────────────────────────────────────────────────────────────────────

readonly SCRIPT_NAME="devshakti-gpu-select"
readonly VERSION="1.0.0"
readonly CONFIG_DIR="/etc/devshakti"
readonly MODE_FILE="${CONFIG_DIR}/gpu-mode"
readonly ENV_FILE="/etc/environment"
readonly NVIDIA_PCI_CLASS="0x030000"    # PCI class for 3D controller (dGPU)
readonly ICON_GPU="video-display"       # freedesktop icon for notifications

# Colour helpers for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ─────────────────────────────────────────────────────────────────────────────
# Logging Helpers
# ─────────────────────────────────────────────────────────────────────────────

log_info()  { echo -e "${GREEN}[INFO]${RESET}  $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; }
log_error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
log_step()  { echo -e "${CYAN}  →${RESET} $*"; }

# ─────────────────────────────────────────────────────────────────────────────
# Utility Functions
# ─────────────────────────────────────────────────────────────────────────────

# require_root — Abort if the script is not running as root / via sudo.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This operation requires root privileges."
        log_error "Re-run with: sudo ${SCRIPT_NAME} $*"
        exit 1
    fi
}

# require_command — Check that a command exists on the system.
require_command() {
    local cmd="$1"
    if ! command -v "$cmd" &>/dev/null; then
        log_error "Required command '${cmd}' not found. Please install it first."
        exit 1
    fi
}

# get_nvidia_pci_address — Return the sysfs PCI address of the first NVIDIA dGPU.
# Example output: "0000:01:00.0"
get_nvidia_pci_address() {
    local addr
    addr=$(lspci -D -d 10de: -nn 2>/dev/null \
        | grep -i '\[03[0-9][0-9]\]' \
        | head -n1 \
        | awk '{print $1}')
    if [[ -z "$addr" ]]; then
        log_error "No NVIDIA GPU detected on the PCI bus."
        exit 1
    fi
    echo "$addr"
}

# get_amd_pci_address — Return the sysfs PCI address of the first AMD iGPU.
get_amd_pci_address() {
    local addr
    addr=$(lspci -D -d 1002: -nn 2>/dev/null \
        | grep -i '\[03[0-9][0-9]\]' \
        | head -n1 \
        | awk '{print $1}')
    if [[ -z "$addr" ]]; then
        log_error "No AMD GPU detected on the PCI bus."
        exit 1
    fi
    echo "$addr"
}

# notify — Send a desktop notification if a graphical session is available.
# Falls back silently when running headless or from a TTY.
notify() {
    local summary="$1"
    local body="${2:-}"
    # Detect the active graphical user (for sudo sessions).
    local target_user="${SUDO_USER:-${USER:-}}"

    if [[ -z "$target_user" ]]; then
        return 0  # No user context — skip notification
    fi

    # Try to find the user's display/bus address for notify-send
    local uid
    uid=$(id -u "$target_user" 2>/dev/null) || return 0

    local dbus_addr="unix:path=/run/user/${uid}/bus"

    if [[ -S "/run/user/${uid}/bus" ]] && command -v notify-send &>/dev/null; then
        sudo -u "$target_user" \
            DBUS_SESSION_BUS_ADDRESS="$dbus_addr" \
            notify-send \
                --icon="$ICON_GPU" \
                --urgency=normal \
                --app-name="DevShakti GPU" \
                "$summary" "$body" 2>/dev/null || true
    fi
}

# persist_mode — Write the current GPU mode to the config file.
persist_mode() {
    local mode="$1"
    mkdir -p "$CONFIG_DIR"
    echo "$mode" > "$MODE_FILE"
    log_step "Mode persisted to ${MODE_FILE}"
}

# read_current_mode — Read the persisted GPU mode (defaults to "hybrid").
read_current_mode() {
    if [[ -f "$MODE_FILE" ]]; then
        cat "$MODE_FILE"
    else
        echo "hybrid"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Environment File Helpers
# ─────────────────────────────────────────────────────────────────────────────

# remove_gpu_env_vars — Strip all DevShakti GPU-related variables from
# /etc/environment so they can be rewritten cleanly.
remove_gpu_env_vars() {
    if [[ -f "$ENV_FILE" ]]; then
        sed -i '/^# DevShakti GPU Config/d'       "$ENV_FILE"
        sed -i '/^DRI_PRIME=/d'                    "$ENV_FILE"
        sed -i '/^__NV_PRIME_RENDER_OFFLOAD=/d'    "$ENV_FILE"
        sed -i '/^__NV_PRIME_RENDER_OFFLOAD_PROVIDER=/d' "$ENV_FILE"
        sed -i '/^__GLX_VENDOR_LIBRARY_NAME=/d'    "$ENV_FILE"
        sed -i '/^__VK_LAYER_NV_optimus=/d'        "$ENV_FILE"
        sed -i '/^VK_ICD_FILENAMES=/d'             "$ENV_FILE"
        sed -i '/^DEVSHAKTI_GPU_MODE=/d'           "$ENV_FILE"
    fi
}

# write_env_vars — Append a set of key=value pairs to /etc/environment.
# Usage: write_env_vars "KEY1=val1" "KEY2=val2" ...
write_env_vars() {
    {
        echo "# DevShakti GPU Config — managed by ${SCRIPT_NAME}"
        for kv in "$@"; do
            echo "$kv"
        done
    } >> "$ENV_FILE"
    log_step "Updated ${ENV_FILE}"
}

# export_to_session — Also export vars into the current shell session for
# immediate effect (useful if the user sources this or uses eval).
export_to_session() {
    for kv in "$@"; do
        export "$kv"
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA Runtime Power Management
# ─────────────────────────────────────────────────────────────────────────────

# nvidia_power_off — Put the NVIDIA dGPU into D3 (suspended) state via
# sysfs runtime PM controls.
nvidia_power_off() {
    local pci_addr
    pci_addr=$(get_nvidia_pci_address)
    local sysfs="/sys/bus/pci/devices/${pci_addr}"

    if [[ -d "$sysfs" ]]; then
        log_step "Requesting NVIDIA GPU power-down (${pci_addr})..."

        # Enable runtime PM auto-suspend
        echo "auto" > "${sysfs}/power/control" 2>/dev/null || true

        # If the NVIDIA driver exposes a remove file, use it for full power-off
        if [[ -f "${sysfs}/remove" ]]; then
            echo 1 > "${sysfs}/remove" 2>/dev/null || true
            log_step "NVIDIA GPU removed from PCI bus for power savings."
        else
            log_step "Runtime PM set to 'auto' for NVIDIA GPU."
        fi
    else
        log_warn "NVIDIA sysfs path not found — GPU may already be off."
    fi
}

# nvidia_power_on — Ensure the NVIDIA dGPU is powered on and visible on the
# PCI bus. Re-scans if necessary.
nvidia_power_on() {
    local pci_addr
    pci_addr=$(get_nvidia_pci_address 2>/dev/null || true)

    if [[ -z "$pci_addr" ]]; then
        log_step "NVIDIA GPU not on PCI bus — triggering rescan..."
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
        sleep 2
        pci_addr=$(get_nvidia_pci_address)
    fi

    local sysfs="/sys/bus/pci/devices/${pci_addr}"
    if [[ -d "$sysfs" ]]; then
        echo "on" > "${sysfs}/power/control" 2>/dev/null || true
        log_step "NVIDIA GPU powered on (${pci_addr})."
    fi

    # Ensure nvidia kernel modules are loaded
    for mod in nvidia nvidia_modeset nvidia_uvm nvidia_drm; do
        if ! lsmod | grep -qw "$mod"; then
            modprobe "$mod" 2>/dev/null || true
        fi
    done
    log_step "NVIDIA kernel modules verified."
}

# ─────────────────────────────────────────────────────────────────────────────
# GPU Mode Implementations
# ─────────────────────────────────────────────────────────────────────────────

# mode_amd — AMD-only rendering.
# The NVIDIA dGPU is powered down to save battery. All rendering is done
# by the AMD Radeon 680M integrated GPU using the amdgpu/radeonsi drivers.
mode_amd() {
    require_root "$@"

    log_info "Switching to ${BOLD}AMD-only${RESET} GPU mode..."

    # 1. Power-down NVIDIA dGPU
    nvidia_power_off

    # 2. Set environment variables for AMD rendering
    remove_gpu_env_vars
    write_env_vars \
        "DRI_PRIME=0" \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json:/usr/share/vulkan/icd.d/radeon_icd.i686.json" \
        "DEVSHAKTI_GPU_MODE=amd"

    export_to_session \
        "DRI_PRIME=0" \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json:/usr/share/vulkan/icd.d/radeon_icd.i686.json" \
        "DEVSHAKTI_GPU_MODE=amd"

    # 3. Persist mode
    persist_mode "amd"

    log_info "GPU mode set to ${BOLD}AMD${RESET}. NVIDIA GPU is powered down."
    log_info "A session restart may be needed for full effect."

    notify "GPU → AMD Only" "NVIDIA dGPU powered down. Rendering via AMD Radeon 680M."
}

# mode_nvidia — NVIDIA-primary rendering.
# The NVIDIA RTX 4050 is set as the primary renderer. The AMD iGPU handles
# the display output, but all 3D rendering is offloaded to the dGPU.
mode_nvidia() {
    require_root "$@"

    log_info "Switching to ${BOLD}NVIDIA-primary${RESET} GPU mode..."

    # 1. Ensure NVIDIA GPU is powered on
    nvidia_power_on

    # 2. Set environment for NVIDIA PRIME rendering
    remove_gpu_env_vars
    write_env_vars \
        "__NV_PRIME_RENDER_OFFLOAD=1" \
        "__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0" \
        "__GLX_VENDOR_LIBRARY_NAME=nvidia" \
        "__VK_LAYER_NV_optimus=NVIDIA_only" \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json" \
        "DEVSHAKTI_GPU_MODE=nvidia"

    export_to_session \
        "__NV_PRIME_RENDER_OFFLOAD=1" \
        "__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0" \
        "__GLX_VENDOR_LIBRARY_NAME=nvidia" \
        "__VK_LAYER_NV_optimus=NVIDIA_only" \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json" \
        "DEVSHAKTI_GPU_MODE=nvidia"

    # 3. Persist mode
    persist_mode "nvidia"

    log_info "GPU mode set to ${BOLD}NVIDIA${RESET}. RTX 4050 is the primary renderer."
    log_info "A session restart may be needed for full effect."

    notify "GPU → NVIDIA Primary" "RTX 4050 is now the primary renderer for all applications."
}

# mode_hybrid — Hybrid PRIME offloading (default).
# AMD Radeon 680M handles the display and lightweight rendering.
# NVIDIA RTX 4050 is available on-demand via 'prime-run <app>'.
mode_hybrid() {
    require_root "$@"

    log_info "Switching to ${BOLD}Hybrid${RESET} GPU mode (PRIME offloading)..."

    # 1. Ensure NVIDIA GPU is powered on (available for offloading)
    nvidia_power_on

    # 2. Set environment — no forced offloading, rely on prime-run
    remove_gpu_env_vars
    write_env_vars \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json:/usr/share/vulkan/icd.d/nvidia_icd.json" \
        "DEVSHAKTI_GPU_MODE=hybrid"

    export_to_session \
        "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.x86_64.json:/usr/share/vulkan/icd.d/nvidia_icd.json" \
        "DEVSHAKTI_GPU_MODE=hybrid"

    # 3. Enable runtime PM so the dGPU suspends when idle
    local pci_addr
    pci_addr=$(get_nvidia_pci_address 2>/dev/null || true)
    if [[ -n "$pci_addr" ]]; then
        local sysfs="/sys/bus/pci/devices/${pci_addr}"
        if [[ -d "$sysfs" ]]; then
            echo "auto" > "${sysfs}/power/control" 2>/dev/null || true
            log_step "NVIDIA runtime PM set to 'auto' (suspends when idle)."
        fi
    fi

    # 4. Persist mode
    persist_mode "hybrid"

    log_info "GPU mode set to ${BOLD}Hybrid${RESET}."
    log_info "  • Desktop/light apps → AMD Radeon 680M"
    log_info "  • Games/heavy apps   → prime-run <application>"

    notify "GPU → Hybrid" "AMD for desktop, NVIDIA via prime-run for games/heavy apps."
}

# ─────────────────────────────────────────────────────────────────────────────
# Status Display
# ─────────────────────────────────────────────────────────────────────────────

show_status() {
    local mode
    mode=$(read_current_mode)

    echo ""
    echo -e "${BOLD}╔══════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}║       DevShakti OS — GPU Status          ║${RESET}"
    echo -e "${BOLD}╚══════════════════════════════════════════╝${RESET}"
    echo ""

    # Current mode
    echo -e "  ${BOLD}Active Mode:${RESET}  ${CYAN}${mode}${RESET}"
    echo ""

    # Detected GPUs
    echo -e "  ${BOLD}Detected GPUs:${RESET}"
    if command -v lspci &>/dev/null; then
        lspci -nn 2>/dev/null | grep -iE '\[03[0-9][0-9]\]' | while IFS= read -r line; do
            echo -e "    ${GREEN}•${RESET} ${line}"
        done
    else
        echo -e "    ${YELLOW}(lspci not available)${RESET}"
    fi
    echo ""

    # Active renderer (via glxinfo if available)
    echo -e "  ${BOLD}Active Renderer:${RESET}"
    if command -v glxinfo &>/dev/null; then
        local renderer
        renderer=$(glxinfo 2>/dev/null | grep "OpenGL renderer" | head -n1 | sed 's/.*: //')
        if [[ -n "$renderer" ]]; then
            echo -e "    ${GREEN}${renderer}${RESET}"
        else
            echo -e "    ${YELLOW}(could not determine — no display?)${RESET}"
        fi
    else
        echo -e "    ${YELLOW}(glxinfo not installed — install mesa-utils)${RESET}"
    fi
    echo ""

    # Vulkan info (via vulkaninfo if available)
    echo -e "  ${BOLD}Vulkan Devices:${RESET}"
    if command -v vulkaninfo &>/dev/null; then
        vulkaninfo --summary 2>/dev/null \
            | grep -E "deviceName|driverName" \
            | sed 's/^[[:space:]]*/    /' \
            || echo -e "    ${YELLOW}(could not query Vulkan)${RESET}"
    else
        echo -e "    ${YELLOW}(vulkaninfo not installed — install vulkan-tools)${RESET}"
    fi
    echo ""

    # NVIDIA power state
    echo -e "  ${BOLD}NVIDIA Power State:${RESET}"
    local nvidia_pci
    nvidia_pci=$(lspci -D -d 10de: -nn 2>/dev/null | grep -i '\[03[0-9][0-9]\]' | head -n1 | awk '{print $1}')
    if [[ -n "$nvidia_pci" ]]; then
        local power_file="/sys/bus/pci/devices/${nvidia_pci}/power/runtime_status"
        if [[ -f "$power_file" ]]; then
            local state
            state=$(cat "$power_file")
            case "$state" in
                active)     echo -e "    ${GREEN}Active (powered on)${RESET}" ;;
                suspended)  echo -e "    ${YELLOW}Suspended (power saving)${RESET}" ;;
                *)          echo -e "    ${CYAN}${state}${RESET}" ;;
            esac
        else
            echo -e "    ${YELLOW}(runtime status unavailable)${RESET}"
        fi
    else
        echo -e "    ${RED}NVIDIA GPU not detected on PCI bus${RESET}"
    fi
    echo ""

    # Environment variables
    echo -e "  ${BOLD}GPU Environment Variables:${RESET}"
    local found_any=false
    for var in DRI_PRIME __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME \
               __VK_LAYER_NV_optimus VK_ICD_FILENAMES DEVSHAKTI_GPU_MODE; do
        local val="${!var:-}"
        if [[ -n "$val" ]]; then
            echo -e "    ${var}=${CYAN}${val}${RESET}"
            found_any=true
        fi
    done
    if [[ "$found_any" == false ]]; then
        echo -e "    ${YELLOW}(none set in current session)${RESET}"
    fi
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Help / Usage
# ─────────────────────────────────────────────────────────────────────────────

show_help() {
    cat <<EOF

${BOLD}DevShakti OS — GPU Select v${VERSION}${RESET}

Switch between AMD, NVIDIA, and Hybrid GPU rendering modes on dual-GPU
laptops with AMD iGPU + NVIDIA dGPU (PRIME offloading).

${BOLD}USAGE:${RESET}
    sudo ${SCRIPT_NAME} <mode>
    ${SCRIPT_NAME} --status
    ${SCRIPT_NAME} --help

${BOLD}MODES:${RESET}
    ${GREEN}amd${RESET}       AMD-only rendering. NVIDIA dGPU is powered down for
              maximum battery life. All rendering via AMD Radeon iGPU.

    ${GREEN}nvidia${RESET}    NVIDIA-primary rendering. The RTX 4050 dGPU handles
              all 3D rendering. Maximum performance, higher power draw.

    ${GREEN}hybrid${RESET}    Hybrid PRIME offloading (default). AMD handles the
              desktop; NVIDIA is available on-demand via ${CYAN}prime-run${RESET}.
              Best balance of battery life and performance.

${BOLD}OPTIONS:${RESET}
    --status  Show current GPU mode, active renderer, and power state.
    --help    Show this help message.

${BOLD}EXAMPLES:${RESET}
    sudo ${SCRIPT_NAME} amd        # Switch to AMD-only (battery saver)
    sudo ${SCRIPT_NAME} nvidia     # Switch to NVIDIA-primary (performance)
    sudo ${SCRIPT_NAME} hybrid     # Switch to hybrid offloading (balanced)
    ${SCRIPT_NAME} --status        # Check current GPU status

${BOLD}NOTES:${RESET}
    • Mode changes take full effect after a session restart (logout/login).
    • The current mode is persisted in ${MODE_FILE}.
    • In hybrid mode, launch GPU-intensive apps with: prime-run <app>
    • Environment variables are written to ${ENV_FILE}.

EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main Entry Point
# ─────────────────────────────────────────────────────────────────────────────

main() {
    # No arguments — show help
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local action="${1,,}"  # Lowercase the first argument

    case "$action" in
        amd)
            mode_amd "$@"
            ;;
        nvidia)
            mode_nvidia "$@"
            ;;
        hybrid)
            mode_hybrid "$@"
            ;;
        --status|-s|status)
            show_status
            ;;
        --help|-h|help)
            show_help
            ;;
        --version|-v)
            echo "${SCRIPT_NAME} v${VERSION}"
            ;;
        *)
            log_error "Unknown mode or option: '${1}'"
            echo ""
            echo "Valid modes: amd, nvidia, hybrid"
            echo "Valid options: --status, --help, --version"
            exit 1
            ;;
    esac
}

main "$@"
