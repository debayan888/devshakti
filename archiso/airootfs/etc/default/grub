# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    DevShakti OS — GRUB Bootloader Configuration            ║
# ║                                                                            ║
# ║  GRUB 2 defaults for HP Victus 15                                         ║
# ║  Ryzen 7 7445HS · Radeon 760M · RTX 4050 · 16GB DDR5 · 75Wh battery      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# This file is sourced by grub-mkconfig(8) to generate /boot/grub/grub.cfg.
# After editing, regenerate the GRUB configuration:
#
#   sudo grub-mkconfig -o /boot/grub/grub.cfg
#
# Reference: info grub, grub-mkconfig(8)
# ──────────────────────────────────────────────────────────────────────────────


# ── Boot Menu Behavior ───────────────────────────────────────────────────────

# Default boot entry (0 = first entry). Can also be "saved" to remember last
# choice when GRUB_SAVEDEFAULT is enabled.
GRUB_DEFAULT=0

# Seconds to display the boot menu before auto-booting the default entry.
# Set to 0 for instant boot, -1 to wait indefinitely.
GRUB_TIMEOUT=3

# Timeout style:
#   "menu"    — Always show the menu during the timeout countdown
#   "hidden"  — Hide the menu; press Shift/Esc to reveal it
#   "countdown" — Show a countdown timer without the full menu
GRUB_TIMEOUT_STYLE=menu

# Save the last-selected entry and boot it next time (requires GRUB_DEFAULT=saved).
#GRUB_SAVEDEFAULT=true


# ── Kernel Command Line ─────────────────────────────────────────────────────

# Parameters appended to the Linux kernel command line for NORMAL boot entries.
# These do NOT apply to recovery/fallback entries.
#
#   quiet                          — Suppress most kernel log messages
#   splash                         — Enable Plymouth graphical boot splash
#   loglevel=3                     — Show only KERN_ERR and above on console
#   rd.systemd.show_status=auto    — Show systemd status only if boot is slow
#   rd.udev.log_level=3            — Reduce udev verbosity during initramfs
#   vt.global_cursor_default=0     — Hide the blinking text cursor (cleaner splash)
#   nvidia_drm.modeset=1           — Enable NVIDIA DRM kernel modesetting
#                                    (required for Wayland + GBM on RTX 4050)
#   amd_pstate=active              — Enable AMD P-State EPP driver for Ryzen 7
#                                    7445HS (active mode = autonomous frequency
#                                    scaling with the highest efficiency)
#
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.systemd.show_status=auto rd.udev.log_level=3 vt.global_cursor_default=0 nvidia_drm.modeset=1 amd_pstate=active"

# Parameters appended to the Linux kernel command line for ALL entries,
# including recovery/fallback. Use for parameters that must always be present.
GRUB_CMDLINE_LINUX=""


# ── Distributor & Branding ───────────────────────────────────────────────────

# Name shown in the GRUB menu title and os-prober entries.
GRUB_DISTRIBUTOR="DevShakti"


# ── Console & Terminal ───────────────────────────────────────────────────────

# Console output configuration. Uncomment to redirect kernel messages.
#GRUB_TERMINAL_INPUT=console
#GRUB_TERMINAL_OUTPUT=console

# Serial console parameters (for headless/remote debugging).
#GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"


# ── Graphics & Resolution ───────────────────────────────────────────────────

# GRUB graphical mode resolution. "auto" lets GRUB pick the best mode.
# Specific modes: "1920x1080x32", "2560x1440x32", etc.
GRUB_GFXMODE=auto

# Inherit GRUB's graphics mode into the Linux framebuffer (for a seamless
# transition from bootloader → Plymouth → display manager).
GRUB_GFXPAYLOAD_LINUX=keep


# ── OS Prober (Dual-Boot Detection) ─────────────────────────────────────────

# Allow os-prober to detect other operating systems (Windows, other Linux
# distros) and add them to the GRUB menu. Set to "true" to DISABLE detection.
GRUB_DISABLE_OS_PROBER=false


# ── Recovery & Submenu ───────────────────────────────────────────────────────

# Generate recovery/fallback entries for each kernel.
#GRUB_DISABLE_RECOVERY=true

# Place older kernels and recovery entries in a submenu to keep the main
# menu clean. Disable if you want all entries at the top level.
#GRUB_DISABLE_SUBMENU=y


# ── Encryption & Security ───────────────────────────────────────────────────

# If using LUKS full-disk encryption, enable the GRUB cryptodisk module
# to decrypt /boot at GRUB stage.
#GRUB_ENABLE_CRYPTODISK=y

# Preload specific GRUB modules (space-separated). Useful for encrypted boot
# or special filesystem support.
#GRUB_PRELOAD_MODULES="part_gpt part_msdos luks2 cryptodisk"


# ── Theme & Appearance ──────────────────────────────────────────────────────

# Path to a GRUB theme directory containing a theme.txt file.
# DevShakti ships a custom branded GRUB theme.
#GRUB_THEME="/boot/grub/themes/devshakti/theme.txt"

# Solid background color if no theme or wallpaper is set (R,G,B in hex).
#GRUB_BACKGROUND="/boot/grub/themes/devshakti/background.png"
#GRUB_COLOR_NORMAL="light-gray/black"
#GRUB_COLOR_HIGHLIGHT="white/blue"


# ── Miscellaneous ───────────────────────────────────────────────────────────

# Disable generation of "if" statements in grub.cfg that check for specific
# UUIDs. Reduces grub.cfg size on multi-disk systems.
#GRUB_DISABLE_LINUX_UUID=true

# Generate entries for Linux Partuuid instead of UUID.
#GRUB_DISABLE_LINUX_PARTUUID=false

# Uncomment to set a GRUB password (grub-mkpasswd-pbkdf2 output).
#GRUB_PASSWORD="grub.pbkdf2.sha512.10000.HASH"
